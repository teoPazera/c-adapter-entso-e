  "model": {
    "type": "sklearn.linear_model.LassoLarsIC",
    "criterion": "aic",
    "per_hour_independent": true,
    "n_hour_models": 24,
    "scaler": "asinh((x - median) / MAD) per column, fit on the calibration window only; target scaled the same way per hour, predictions inverse-transformed (sinh)",
    "noise_variance": {
      "issue": "sklearn LassoLarsIC(criterion=\"aic\") needs an explicit noise_variance when n_samples <= n_features+1 (raises otherwise, added sklearn 1.1) -- true for the 1-year window (365 <= 542) but not the 2-year window (730 > 542)",
      "resolution": "when n_samples > n_features+1: sklearn default (OLS-based unbiased estimator). Otherwise: ridge-regression fallback (src/s3_lear.py:_ridge_noise_variance) -- ridge penalty = mean squared singular value of X (data-scaled heuristic, no extra CV), noise_variance = RSS_ridge / (n - effective_df_ridge) per hour. X's SVD computed once per day, reused across all 24 hours.",
      "recorded_per_model": "DayModel.noise_variance_method in {\"ols\", \"ridge_fallback\"}"
    },
    "numerical_failure_fallback": "LassoLarsIC.fit() occasionally raises internally on this feature set's near-singular active sets (sklearn 1.9.1 lars_path shape-mismatch, beyond the routine ConvergenceWarning); caught in src/s3_lear.py:_fit_one_hour, degrades to the same zero/median model used for too-few-valid-rows hours, counted in DayModel.n_numerical_failure_hours",
    "predict_time_nan_fallback": "if any feature is still NaN at predict time (should not happen given fit-time ffill/bfill), predict_day substitutes that feature's calibration-window median (src/s3_lear.py:predict_day) rather than propagating NaN into the forecast",
    "lars_blowup_fallback": "LassoLarsIC.fit() can return WITHOUT raising while producing coefficients many orders of magnitude too large (observed: up to 2.7e13 vs <=1.64 on every other fit, across an exhaustive scan of all 1531 cached models). Root cause, confirmed by direct inspection: a near-duplicate pair of unavail_tx_import_mw night-hour (h02/h03/h04) lag columns, identical on ~99.5% of calibration days, drives LARS's active set into a degenerate +c/-c pair fitting only the rare days where the two columns differ -- not a real Lasso optimum at any finite alpha. Not caught by numerical_failure_fallback above, since no exception is thrown. Fixed at fit time (superseding the earlier 2026-09-12 'document, don't patch' decision -- see notes/03-baseline.md Finding 11's Resolution subsection): src/s3_lear.py:_fit_one_hour checks max(abs(coef_)) > COEF_BLOWUP_THRESHOLD (1e3; nothing observed between 1.64 and 8.9e10) after a successful LassoLarsIC fit, and if it fires, refits the same hour with sklearn.linear_model.Lasso at the same AIC-chosen alpha_ (both classes share the (1/2n)||y-Xw||^2 + alpha||w||_1 objective) via coordinate descent, which cannot produce this artefact. Fired on 12 of 1169 test-slice hours and 9 of 181 one-year-window validation hours (0 of 181 two-year-window validation hours); after the fix max|coef| across all 1531 cached models is 1.64. Tracked per model as DayModel.n_lars_blowup_hours; if a coordinate-descent refit somehow still exceeds the threshold, it degrades to the same zero/median model as numerical_failure_fallback and is counted in both fields. Consumers of a saved DayModel (S4/S5) no longer need their own load-time coefficient sanity check for this specific failure mode."
  },
  "nan_policy": {
    "source_table_ffill": "src/s3_features.py:load_table forward-fills price/exogenous/hydro columns from the full history before any window is taken (not per-window), so a window's own first row can still be filled from data just outside it. Before/after NaN counts per column reported in notes/03-baseline.md.",
    "solar_pre_2021_12": "zero-filled at source in src/s1_build_table.py:build_wind_solar (no Solar column published for SE3 before 2021-12; near-zero real capacity, see notes/03-baseline.md)",
    "per_window_feature_matrix": "ffill then bfill across the window's own calibration days as a final safety net (only fires on rare DST spring-forward single-hour gaps or a window's own leading edge) -- counts recorded in DayModel.n_ffill_feature_nan / n_bfill_feature_nan",
    "targets": "rows (day, hour) with NaN target excluded from that hour's fit via a per-hour valid mask (src/s3_lear.py:_fit_one_hour) -- occurs only on the skipped hour of a 23-hour DST spring-forward day",
    "degenerate_hours": "if fewer than 10 valid target rows exist for a given hour in the window, that hour gets a zero model (predicts the scaled median) instead of failing -- DayModel.n_degenerate_hours"
  },
  "windows_days": {
    "1y": 365,
    "2y": 730
  },
  "quantile_grid": [
    0.05,
    0.1,
    0.15,
    0.2,
    0.25,
    0.3,
    0.35,
    0.4,
    0.45,
    0.5,
    0.55,
    0.6,
    0.65,
    0.7,
    0.75,
    0.8,
    0.85,
    0.9,
    0.95
  ],
  "quantile_forecast": {
    "method": "point_forecast + empirical tau-quantile of a per-hour-of-day rolling window of trailing (actual - point_forecast) residuals",
    "rolling_window_days": 90,
    "min_days_before_scoring": 28,
    "naive_benchmark_gets_the_same_construction": true,
    "implementation": "src/s3_metrics.py:RollingResidualQuantiles"
  },
  "naive_benchmarks": {
    "lago_standard": "price of D-1 on Tue-Fri, price of D-7 on Mon/Sat/Sun (src/s3_metrics.py:naive_lago_forecast)",
    "lag24_reference": "price of D-1 always (src/s3_metrics.py:naive_lag24_forecast)"
  },
  "slices": {
    "validation": [
      "2023-01-01",
      "2023-06-30"
    ],
    "test": [
      "2023-07-01",
      "2026-09-11"
    ]
  },
  "window_selection_rule": "lower validation-slice MAE",
  "recalibration": "daily by default (--recalib-every 1); --recalib-every N refits every N days and reuses the prior fit in between if the daily cadence exceeds the time budget"
}